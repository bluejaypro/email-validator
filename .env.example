# Server
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# SMTP verification
SMTP_FROM_ADDRESS=verify@yourdomain.com
SMTP_TIMEOUT=10
DNS_TIMEOUT=5

# Bulk processing
MAX_BULK_EMAILS=5000
CONCURRENT_WORKERS=50

# Rate limiting
RATE_LIMIT_SINGLE=30/minute
RATE_LIMIT_BULK=5/minute

# File upload
MAX_UPLOAD_SIZE_BYTES=5242880
